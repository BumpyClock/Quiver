<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Quiver.App.Views.BrowsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctlabs="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Quiver.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="using:Quiver.App.Controls"
    xmlns:vm="using:Quiver.App.ViewModels"
    mc:Ignorable="d">

    <Grid MaxWidth="800" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <BreadcrumbBar ItemClicked="BreadcrumbBar_ItemClicked" ItemsSource="{x:Bind BreadcrumbItems}" />
        <ListView
            x:Name="BrowserList"
            Grid.Row="1"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="True"
            ContainerContentChanging="BrowserList_ContainerContentChanging"
            DragItemsCompleted="ListView_DragItemsCompleted"
            ItemsSource="{x:Bind ViewModel.Browsers}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:BrowserItemViewModel">
                    <ctlabs:SettingsCard Description="{x:Bind Model.ExePath, Mode=OneWay}" Header="{x:Bind Model.Name, Mode=OneWay}">
                        <ctlabs:SettingsCard.HeaderIcon>
                            <ImageIcon Source="{x:Bind Icon, Mode=OneWay}" />
                        </ctlabs:SettingsCard.HeaderIcon>
                        <SplitButton x:Name="myColorButton" Click="EditBrowser_Click">
                            Edit
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Click="DeleteBrowser_Click" Tag="{x:Bind Model.Id}">
                                        Delete
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                    </ctlabs:SettingsCard>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Other Options" />
            <StackPanel>
                <ctlabs:SettingsCard Description="Add a custom browser or app entry manually" Header="Add browser entry">
                    <ctlabs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE710;" />
                    </ctlabs:SettingsCard.HeaderIcon>
                    <Button
                        Width="80"
                        Click="CreateBrowser_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        Create
                    </Button>
                </ctlabs:SettingsCard>
                <ctlabs:SettingsCard Description="Finds and Appends newly installed browsers" Header="Refresh browsers">
                    <ctlabs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72C;" />
                    </ctlabs:SettingsCard.HeaderIcon>
                    <Button
                        Width="80"
                        Click="RefreshButton_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        Refresh
                    </Button>
                </ctlabs:SettingsCard>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
