<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Quiver.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Quiver.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel MaxWidth="800" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Selector Settings" />

                <StackPanel>
                    <toolkit:SettingsCard Description="Close the browser picker when you click outside it" Header="Close on Focus Loss">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8C5;" />
                        </toolkit:SettingsCard.HeaderIcon>

                        <ToggleSwitch IsOn="{x:Bind ViewModel.Option_MinimizeOnFocusLoss, Mode=TwoWay}" />
                    </toolkit:SettingsCard>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Other Settings" />

                <StackPanel>
                    <toolkit:SettingsCard
                        Click="DefaultAppButton_Click"
                        Description="Set Quiver as the default browser app"
                        Header="Windows default app settings"
                        IsClickEnabled="True">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xECAA;" />
                        </toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Edit the settings file" IsClickEnabled="True">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE943;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <Button
                            Width="80"
                            Click="EditJsonButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            Edit
                        </Button>
                    </toolkit:SettingsCard>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</Page>
