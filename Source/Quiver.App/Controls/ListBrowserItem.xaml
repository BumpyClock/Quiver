<?xml version="1.0" encoding="utf-8" ?>
<controls:BrowserItemControl
    x:Class="Quiver.App.Controls.ListBrowserItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Quiver.App.Controls"
    Height="52">
    <controls:BrowserItemControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ListSelectedFill" Color="#E8EDF5" />
                    <SolidColorBrush x:Key="ListSelectedStroke" Color="#B7C6D8" />
                    <SolidColorBrush x:Key="ListSelectedForeground" Color="#182432" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ListSelectedFill" Color="#343D49" />
                    <SolidColorBrush x:Key="ListSelectedStroke" Color="#5B6879" />
                    <SolidColorBrush x:Key="ListSelectedForeground" Color="#F7F8FA" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ListSelectedFill" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ListSelectedStroke" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ListSelectedForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </controls:BrowserItemControl.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="ListSelection.Opacity" Value="1" />
                        <Setter Target="BrowserName.Foreground" Value="{ThemeResource ListSelectedForeground}" />
                        <Setter Target="ProfileName.Foreground" Value="{ThemeResource ListSelectedForeground}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border
            x:Name="RowBoundary"
            Margin="8,0"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            IsHitTestVisible="False" />
        <Border
            x:Name="ListSelection"
            Background="{ThemeResource ListSelectedFill}"
            BorderBrush="{ThemeResource ListSelectedStroke}"
            BorderThickness="1"
            CornerRadius="8"
            IsHitTestVisible="False"
            Opacity="0" />
        <Button
            x:Name="LaunchButton"
            Padding="12,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            AutomationProperties.Name="{x:Bind BrowserItem.Name, Mode=OneWay}"
            Background="Transparent"
            BorderThickness="0"
            Click="LaunchButton_Click"
            CornerRadius="8"
            FocusVisualPrimaryBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
            FocusVisualPrimaryThickness="2"
            FocusVisualSecondaryThickness="1"
            ToolTipService.ToolTip="{x:Bind ToolTipText, Mode=OneWay}">
            <Button.Resources>
                <ResourceDictionary>
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                </ResourceDictionary>
            </Button.Resources>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    x:Name="BrowserIcon"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Center"
                    Source="{x:Bind BrowserItem.Icon, Mode=OneWay}" />
                <StackPanel
                    x:Name="IdentityText"
                    Grid.Column="1"
                    MinHeight="36"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock
                        x:Name="BrowserName"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        MaxLines="1"
                        Text="{x:Bind BrowserItem.Model.Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <Grid
                        x:Name="ProfileLine"
                        ColumnSpacing="6"
                        Visibility="{x:Bind ProfileBadgeVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="ProfileBadge" Width="14" Height="14" VerticalAlignment="Center">
                            <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="7"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Text="{x:Bind BrowserItem.ProfileInitial, Mode=OneWay}" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{x:Bind BrowserItem.ProfileAvatar, Mode=OneWay}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <TextBlock
                            x:Name="ProfileName"
                            Grid.Column="1"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Grid>
                </StackPanel>
                <Border
                    x:Name="ShortcutBadge"
                    Grid.Column="1"
                    MinWidth="24"
                    Height="22"
                    Padding="4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="{x:Bind ShortcutVisibility, Mode=OneWay}">
                    <TextBlock
                        x:Name="ShortcutText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind ShortcutNumber, Mode=OneWay}" />
                </Border>
            </Grid>
        </Button>
    </Grid>
</controls:BrowserItemControl>
