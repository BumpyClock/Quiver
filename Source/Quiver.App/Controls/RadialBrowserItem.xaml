<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Quiver.App.Controls.RadialBrowserItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="104"
    Height="104"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PetalForeground" Color="#F7F8FA" />
                    <SolidColorBrush x:Key="PetalSelectedForeground" Color="#F7F8FA" />
                    <SolidColorBrush x:Key="PetalShortcutForeground" Color="#F7F8FA" />
                    <SolidColorBrush x:Key="PetalShortcutSelectedForeground" Color="#F7F8FA" />
                    <SolidColorBrush x:Key="PetalShortcutFill" Color="#353535" />
                    <SolidColorBrush x:Key="PetalShortcutSelectedFill" Color="#404854" />
                    <SolidColorBrush x:Key="PetalPressedFill" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="PetalInk" Color="#202020" />
                    <SolidColorBrush x:Key="PetalIconFill" Color="#2C2C2C" />
                    <SolidColorBrush x:Key="PetalIconStroke" Color="#20FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PetalForeground" Color="#182432" />
                    <SolidColorBrush x:Key="PetalSelectedForeground" Color="#182432" />
                    <SolidColorBrush x:Key="PetalShortcutForeground" Color="#182432" />
                    <SolidColorBrush x:Key="PetalShortcutSelectedForeground" Color="#182432" />
                    <SolidColorBrush x:Key="PetalShortcutFill" Color="#EFFFFFFF" />
                    <SolidColorBrush x:Key="PetalShortcutSelectedFill" Color="#F7FFFFFF" />
                    <SolidColorBrush x:Key="PetalPressedFill" Color="#14182432" />
                    <SolidColorBrush x:Key="PetalInk" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PetalIconFill" Color="#F7FFFFFF" />
                    <SolidColorBrush x:Key="PetalIconStroke" Color="#18000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PetalForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PetalSelectedForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PetalShortcutForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PetalShortcutSelectedForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PetalShortcutFill" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PetalShortcutSelectedFill" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PetalPressedFill" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PetalInk" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PetalIconFill" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PetalIconStroke" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="PetalName.Foreground" Value="{ThemeResource PetalSelectedForeground}" />
                        <Setter Target="ShortcutText.Foreground" Value="{ThemeResource PetalShortcutSelectedForeground}" />
                        <Setter Target="ShortcutBadge.Background" Value="{ThemeResource PetalShortcutSelectedFill}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Button
            x:Name="LaunchButton"
            MinWidth="0"
            MinHeight="0"
            Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            AutomationProperties.Name="{x:Bind BrowserItem.Name, Mode=OneWay}"
            BorderThickness="0"
            Click="LaunchButton_Click"
            CornerRadius="52"
            UseSystemFocusVisuals="False"
            ToolTipService.ToolTip="{x:Bind ToolTipText, Mode=OneWay}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PressedDisc.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Ellipse Fill="Transparent" />
                        <Ellipse
                            x:Name="PressedDisc"
                            Fill="{ThemeResource PetalPressedFill}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <ContentPresenter
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{TemplateBinding Content}"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="5">
                    <Grid
                        x:Name="IconTile"
                        Width="58"
                        Height="58"
                        HorizontalAlignment="Center">
                        <Border
                            x:Name="IconSurface"
                            Background="{ThemeResource PetalIconFill}"
                            BorderBrush="{ThemeResource PetalIconStroke}"
                            BorderThickness="1"
                            CornerRadius="16">
                            <Image
                                x:Name="BrowserIcon"
                                Width="44"
                                Height="44"
                                Source="{x:Bind BrowserItem.Icon, Mode=OneWay}" />
                        </Border>
                        <Grid
                            Width="17"
                            Height="17"
                            Margin="0,0,-3,-2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Visibility="{x:Bind ProfileBadgeVisibility, Mode=OneWay}">
                            <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="8"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Text="{x:Bind BrowserItem.ProfileInitial, Mode=OneWay}" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{x:Bind BrowserItem.ProfileAvatar, Mode=OneWay}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Stroke="{ThemeResource PetalInk}" StrokeThickness="2" />
                        </Grid>
                        <Border
                            x:Name="ShortcutBadge"
                            Width="24"
                            Height="20"
                            Margin="0,0,0,3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource PetalShortcutFill}"
                            BorderBrush="{ThemeResource PetalIconStroke}"
                            BorderThickness="1"
                            CornerRadius="6"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind ShortcutVisibility, Mode=OneWay}">
                            <TextBlock
                                x:Name="ShortcutText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PetalShortcutForeground}"
                                Text="{x:Bind ShortcutNumber, Mode=OneWay}" />
                        </Border>
                    </Grid>
                    <TextBlock
                        x:Name="PetalName"
                        MaxWidth="80"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource PetalForeground}"
                        MaxLines="1"
                        Text="{x:Bind BrowserItem.ShortName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>
        </Button>
    </Grid>
</UserControl>
