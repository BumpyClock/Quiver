<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Quiver.App.Windows.SelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Quiver.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Quiver.App.ViewModels"
    x:Name="SelectorRoot"
    Title="Quiver - Select"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <!--  The window is clipped to a circle, so the acrylic backdrop forms the disc.  -->
    <Grid
        x:Name="DiscRoot"
        KeyboardAcceleratorPlacementMode="Hidden"
        PreviewKeyDown="DiscRoot_PreviewKeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="C" Invoked="CopyAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="E"
                Invoked="EditUrlAccelerator_Invoked"
                Modifiers="Menu" />
            <KeyboardAccelerator Key="R" Invoked="RulesAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Ellipse
            Margin="1"
            IsHitTestVisible="False"
            Stroke="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            StrokeThickness="1.5" />

        <ItemsRepeater
            x:Name="BrowserRing"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            ElementPrepared="BrowserRing_ElementPrepared"
            ItemsSource="{x:Bind ViewModel.Browsers, Mode=OneWay}"
            TabFocusNavigation="Local">
            <ItemsRepeater.Layout>
                <controls:RadialLayout />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="viewModels:BrowserItemViewModel">
                    <controls:RadialBrowserItem BrowserItem="{x:Bind}" />
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <Button
            x:Name="HubButton"
            Width="112"
            Height="112"
            Padding="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="Link options"
            BorderThickness="1"
            CornerRadius="56"
            ToolTipService.ToolTip="{x:Bind ViewModel.Url, Mode=OneWay}">
            <Button.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <StaticResource x:Key="ButtonBackground" ResourceKey="LayerFillColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="ButtonBackground" ResourceKey="LayerFillColorDefaultBrush" />
                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <StaticResource x:Key="ButtonBackground" ResourceKey="SystemControlBackgroundBaseLowBrush" />
                            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SystemControlForegroundTransparentBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Button.Resources>
            <Button.Flyout>
                <MenuFlyout
                    x:Name="HubMenu"
                    Opening="HubMenu_Opening"
                    Placement="Bottom"
                    ShouldConstrainToRootBounds="False">
                    <MenuFlyoutItem
                        Click="LinkCopyBtnClick"
                        KeyboardAcceleratorTextOverride="C"
                        Text="Copy link">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        Click="EditUrlBtnClick"
                        KeyboardAcceleratorTextOverride="Alt+E"
                        Text="Edit link">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE70F;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="QuickViewMenuItem"
                        Click="QuickViewBtnClick"
                        Text="Quick View">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Click="RulesBtnClick"
                        KeyboardAcceleratorTextOverride="R"
                        Text="Rules">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE710;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Click="SettingsBtnClick" Text="Settings">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.Flyout>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="HubTitle"
                    HorizontalAlignment="Center"
                    MaxLines="2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="HubSubtitle"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Button>

        <FlyoutBase.AttachedFlyout>
            <Flyout
                x:Name="EditUrlFlyout"
                Closed="EditUrlFlyout_Closed"
                Placement="Bottom"
                ShouldConstrainToRootBounds="False">
                <TextBox
                    x:Name="UrlTextBox"
                    Width="360"
                    Header="Link"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    KeyDown="UrlTextBox_KeyDown"
                    PlaceholderText="https://"
                    Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Flyout>
        </FlyoutBase.AttachedFlyout>
    </Grid>
</Window>
