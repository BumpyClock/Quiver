<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Quiver.App.Windows.SelectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Quiver.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Quiver.App.ViewModels"
    x:Name="SelectorRoot"
    Title="Quiver - Select"
    mc:Ignorable="d">
    <Grid
        x:Name="DiscRoot"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden"
        PreviewKeyDown="DiscRoot_PreviewKeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="C" Invoked="CopyAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="E"
                Invoked="EditUrlAccelerator_Invoked"
                Modifiers="Menu" />
            <KeyboardAccelerator Key="R" Invoked="RulesAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid
            x:Name="FlowerHost"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            RequestedTheme="Dark">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="HubBackground" Color="#202020" />
                            <SolidColorBrush x:Key="HubBackgroundPointerOver" Color="#2B2B2B" />
                            <SolidColorBrush x:Key="HubBackgroundPressed" Color="#333333" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="HubBackground" Color="{ThemeResource SystemColorWindowColor}" />
                            <SolidColorBrush x:Key="HubBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="HubBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <ItemsRepeater
                x:Name="BrowserRing"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ElementIndexChanged="BrowserRing_ElementIndexChanged"
                ElementPrepared="BrowserRing_ElementPrepared"
                ItemsSource="{x:Bind ViewModel.Browsers, Mode=OneWay}"
                TabFocusNavigation="Once">
                <ItemsRepeater.Layout>
                    <controls:RadialLayout />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:BrowserItemViewModel">
                        <controls:RadialBrowserItem BrowserItem="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Button
                x:Name="HubButton"
                Width="48"
                Height="48"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Link options"
                BorderThickness="0"
                Click="HubButton_Click"
                CornerRadius="24"
                ToolTipService.ToolTip="Link options">
                <Button.Resources>
                    <ResourceDictionary>
                        <StaticResource x:Key="ButtonBackground" ResourceKey="HubBackground" />
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="HubBackgroundPointerOver" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="HubBackgroundPressed" />
                    </ResourceDictionary>
                </Button.Resources>
                <FontIcon
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE712;" />
            </Button>
        </Grid>

        <Button
            x:Name="NamePill"
            Padding="16,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.Name="Link options"
            BorderThickness="0"
            CornerRadius="12"
            RequestedTheme="Dark"
            ToolTipService.ToolTip="{x:Bind ViewModel.Url, Mode=OneWay}">
            <Button.Resources>
                <ResourceDictionary>
                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                </ResourceDictionary>
            </Button.Resources>
            <Button.Flyout>
                <MenuFlyout
                    x:Name="LinkMenu"
                    Opening="LinkMenu_Opening"
                    Placement="Bottom"
                    ShouldConstrainToRootBounds="False">
                    <MenuFlyoutItem
                        Click="LinkCopyBtnClick"
                        KeyboardAcceleratorTextOverride="C"
                        Text="Copy link">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        Click="EditUrlBtnClick"
                        KeyboardAcceleratorTextOverride="Alt+E"
                        Text="Edit link">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE70F;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="QuickViewMenuItem"
                        Click="QuickViewBtnClick"
                        Text="Quick View">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Click="RulesBtnClick"
                        KeyboardAcceleratorTextOverride="R"
                        Text="Rules">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE710;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Click="SettingsBtnClick" Text="Settings">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.Flyout>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="PillTitle"
                        MaxLines="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Grid x:Name="PillLink">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="PillLock"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE72E;" />
                        <TextBlock
                            x:Name="PillHost"
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Grid>
                </StackPanel>
                <FontIcon
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE70D;" />
            </Grid>
        </Button>

        <FlyoutBase.AttachedFlyout>
            <Flyout
                x:Name="EditUrlFlyout"
                Closed="EditUrlFlyout_Closed"
                Placement="Bottom"
                ShouldConstrainToRootBounds="False">
                <TextBox
                    x:Name="UrlTextBox"
                    Width="360"
                    Header="Link"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    KeyDown="UrlTextBox_KeyDown"
                    PlaceholderText="https://"
                    Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Flyout>
        </FlyoutBase.AttachedFlyout>
    </Grid>
</Window>
